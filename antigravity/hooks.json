{
  "agents-workflow": {
    "SessionStart": null,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/pre_invocation.py Antigravity",
        "timeout": 10
      }
    ],
    "PostInvocation": null,
    "Stop": [],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/notify.py Antigravity action_needed",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/notify.py Antigravity command_approval",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": null
  }
}
