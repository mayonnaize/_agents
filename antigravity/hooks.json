{
  "agents-workflow": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/pre_invocation.py Antigravity",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/notify.py Antigravity stop",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/notify.py Antigravity action_needed",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
